{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Builds does not honor wrangler "build.command".
  // The dashboard currently runs only `npx wrangler deploy`.
  // scripts/wrangler-with-opennext.mjs compiles OpenNext first.
  "name": "doctoryachts",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "doctoryachts"
    }
  ],
  "observability": {
    "enabled": true
  }
}
